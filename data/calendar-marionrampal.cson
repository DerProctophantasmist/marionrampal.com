events:[{summary:'Oizel à Saint-Martin-des-Champs',description:'Marion Rampal: chant  \nMatthis Pascaud: guitare  \nSimon Tailleu: contrebasse  \nRaphaël Chassin: batterie\n\nVoix nue, posée et frémissante, dans un français créolisé en des contrées rêvées, Marion Rampal en appelle aux inspirants oiseaux. Elle chante merles moqueurs, oies sauvages, drôles de piafs mais aussi marginaux et libertaires de toutes plumes. Entre complaintes poignantes, mélodies raffinées et refrains gouailleurs, le chant doux et farouche d’une artiste éprise d’indépendance.',band:'Oizel',location:{searchName:'Le Roudour, Saint-Martin-des-Champs, France',displayName:'Le Roudour',address:'',postalCode:'29600',locality:'Saint-Martin-des-Champs',country:'France'},start:{dateTime:'2025-03-29T20:30:00+0100',dateTmp:'2025-03-29T19:30:00.000Z',moment:'2025-03-29T19:30:00.000Z'},ticketUrl:'https://www.seetickets.com/fr/d/event/marion-rampal/le-roudour/10415621?utm_source=ic-see-tickets&utm_medium=referral'},{summary:'Oizel à Grenoble',description:'Marion Rampal: chant  \nMatthis Pascaud: guitare  \nSimon Tailleu: contrebasse  \nRaphaël Chassin: batterie\n\nVoix nue, posée et frémissante, dans un français créolisé en des contrées rêvées, Marion Rampal en appelle aux inspirants oiseaux. Elle chante merles moqueurs, oies sauvages, drôles de piafs mais aussi marginaux et libertaires de toutes plumes. Entre complaintes poignantes, mélodies raffinées et refrains gouailleurs, le chant doux et farouche d’une artiste éprise d’indépendance.',band:'Oizel',location:{searchName:'La Belle Électrique, Grenoble, France',displayName:'La Belle Electrique',address:'12 Esplanade Andry Farcy',postalCode:'38000',locality:'Grenoble',country:'France'},start:{dateTime:'2025-04-18T20:00:00+0200',moment:'2025-04-18T18:00:00.000Z',dateTmp:'2025-04-18T18:00:00.000Z'},ticketUrl:'https://www.seetickets.com/fr/d/event/marion-rampal/la-belle-electrique/10397819'},{summary:'Oizel à Bourgoin-Jallieu',description:'Marion Rampal: chant  \nMatthis Pascaud: guitare  \nSimon Tailleu: contrebasse  \nRaphaël Chassin: batterie\n\nVoix nue, posée et frémissante, dans un français créolisé en des contrées rêvées, Marion Rampal en appelle aux inspirants oiseaux. Elle chante merles moqueurs, oies sauvages, drôles de piafs mais aussi marginaux et libertaires de toutes plumes. Entre complaintes poignantes, mélodies raffinées et refrains gouailleurs, le chant doux et farouche d’une artiste éprise d’indépendance.',band:'Oizel',location:{searchName:'Les Abattoirs, Bourgoin-Jallieu, France',displayName:'Les Abattoirs - Scène de Musiques Actuelles',address:"18 Route de l'Isle d'Abeau",postalCode:'38300',locality:'Bourgoin-Jallieu',country:'France'},start:{dateTime:'2025-04-19T20:00:00+0200',dateTmp:'2025-04-19T18:00:00.000Z',moment:'2025-04-19T18:00:00.000Z'},ticketUrl:'https://www.seetickets.com/fr/d/event/marion-rampal-premiere-partie/les-abattoirs/10412129?utm_source=ic-see-tickets&utm_medium=referral'},{summary:'Song for Abbey à Marciac',description:"Marion Rampal: chant\nMatthis Pascaud: guitare\nThibault Gomez: piano, Prophet\nSimon Tailleu: contrebasse\nRaphaël Chassin: batterie\n\nMarion Rampal célèbre l'esprit de la chanteuse et songwriter **Abbey Lincoln**, création 2025 ",band:'Song for Abbey',location:{searchName:"L'Astrada, Marciac, France",displayName:'L’Astrada Marciac',address:'53 Chemin de Ronde',postalCode:'32230',locality:'Marciac',country:'France'},start:{dateTime:'2025-04-26T20:30:00+0200',moment:'2025-04-26T18:30:00.000Z',dateTmp:'2025-04-26T18:30:00.000Z'}},{summary:'Song for Abbey à Coutances',description:"Marion Rampal: chant\nMatthis Pascaud: guitare\nThibault Gomez: piano, Prophet\nSimon Tailleu: contrebasse\nRaphaël Chassin: batterie\n\nMarion Rampal célèbre l'esprit de la chanteuse et songwriter **Abbey Lincoln**, création 2025 ",band:'Song for Abbey',location:{searchName:'Salle Marcel Helie A Coutances, \n                                \n                                    Coutances\n                                \n                                (50)\n                            ',displayName:'Salle Marcel Hélie',address:'Rue de la Halle au Blé',postalCode:'50200',locality:'Coutances',country:'France'},start:{dateTime:'2025-05-31T15:30:00',dateTmp:'2025-05-31T13:30:00.000Z',moment:'2025-05-31T13:30:00.000Z'},ticketUrl:null},{summary:'Oizel à Foix',description:'Marion Rampal: chant  \nMatthis Pascaud: guitare  \nSimon Tailleu: contrebasse  \nRaphaël Chassin: batterie\n\nVoix nue, posée et frémissante, dans un français créolisé en des contrées rêvées, Marion Rampal en appelle aux inspirants oiseaux. Elle chante merles moqueurs, oies sauvages, drôles de piafs mais aussi marginaux et libertaires de toutes plumes. Entre complaintes poignantes, mélodies raffinées et refrains gouailleurs, le chant doux et farouche d’une artiste éprise d’indépendance.',band:'Oizel',location:{searchName:'Le Village Jazz A Foix, \n                                \n                                    Foix\n                                \n                                (09)\n                            ',displayName:"L'Estive, scène nationale de Foix et de l'Ariège",address:'20 Avenue du Général de Gaulle',postalCode:'09000',locality:'Foix',country:'France'},start:{dateTime:'2025-07-24T21:30:00',dateTmp:'2025-07-24T19:30:00.000Z',moment:'2025-07-24T19:30:00.000Z'},ticketUrl:null}],templates:{Oizel:{description:'Marion Rampal: chant  \nMatthis Pascaud: guitare  \nSimon Tailleu: contrebasse  \nRaphaël Chassin: batterie\n\nVoix nue, posée et frémissante, dans un français créolisé en des contrées rêvées, Marion Rampal en appelle aux inspirants oiseaux. Elle chante merles moqueurs, oies sauvages, drôles de piafs mais aussi marginaux et libertaires de toutes plumes. Entre complaintes poignantes, mélodies raffinées et refrains gouailleurs, le chant doux et farouche d’une artiste éprise d’indépendance.',name:'Oizel',$$hashKey:'object:634'},'Le Secret':{description:'Marion Rampal: chant  \nPierre-François Blanchard: piano\n\nLeur *Secret* est une promenade impertinente et élégante entre le **spleen** baudelairien et le **blues**, avec pour guides deux rebelles respectueux qu’aucune musique ne saurait enfermer. Faire d’une **mélodie** de Fauré un standard de jazz ou d’un Lied de Schubert un **pont** pour traverser océans et territoires musicaux, ajouter un temps pour rapprocher Verlaine de la Nouvelle-Orléans, c’est possible ',name:'Le Secret',$$hashKey:'object:425'},'Song for Abbey':{description:"Marion Rampal: chant\nMatthis Pascaud: guitare\nThibault Gomez: piano, Prophet\nSimon Tailleu: contrebasse\nRaphaël Chassin: batterie\n\nMarion Rampal célèbre l'esprit de la chanteuse et songwriter **Abbey Lincoln**, création 2025 ",name:'Song for Abbey',$$hashKey:'object:632'}}